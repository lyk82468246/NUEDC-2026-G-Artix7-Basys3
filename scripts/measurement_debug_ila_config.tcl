# Sourcing is inert. Shared probe contract used by GUI configuration scripts.
proc configure_measurement_debug_ila {ip} {
    set_property -dict [list CONFIG.C_NUM_OF_PROBES 15 \
        CONFIG.C_PROBE0_WIDTH 1 CONFIG.C_PROBE1_WIDTH 17 CONFIG.C_PROBE2_WIDTH 16 \
        CONFIG.C_PROBE3_WIDTH 32 CONFIG.C_PROBE4_WIDTH 12 CONFIG.C_PROBE5_WIDTH 5 \
        CONFIG.C_PROBE6_WIDTH 32 CONFIG.C_PROBE7_WIDTH 12 CONFIG.C_PROBE8_WIDTH 36 \
        CONFIG.C_PROBE9_WIDTH 32 CONFIG.C_PROBE10_WIDTH 96 CONFIG.C_PROBE11_WIDTH 2 \
        CONFIG.C_PROBE12_WIDTH 32 CONFIG.C_PROBE13_WIDTH 32 CONFIG.C_PROBE14_WIDTH 8 \
        CONFIG.C_DATA_DEPTH 1024] $ip
}
